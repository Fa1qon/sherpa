{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "outDir": "dist-electron",
    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "isolatedModules": false,
    "types": ["node"]
  },
  "include": ["src/main/**/*", "src/core/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "tests",
    "bin",
    ".sherpa-build",
    "src/renderer"
  ]
}
