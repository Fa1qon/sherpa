{
  "name": "sherpa-ui-client",
  "version": "0.22.0",
  "description": "Local-first, methodology-driven workspace UI for the Sherpa CLI",
  "author": "Sherpa Team",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:electron",
    "dev:electron": "npm run build:main && electron .",
    "check:signing-key": "node scripts/check-signing-key.mjs",
    "release:inject-key": "node scripts/inject-release-key.mjs",
    "release:sign-manifest": "node scripts/sign-release-manifest.mjs",
    "prebuild": "npm run check:signing-key",
    "build": "vite build",
    "prebuild:main": "npm run check:signing-key",
    "build:main": "tsc -p tsconfig.main.json --noEmit && node scripts/bundle-main.mjs && node scripts/write-cjs-pkg.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "start": "electron .",
    "model:download": "node scripts/download-model.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test --config tests/visual/playwright.config.ts",
    "test:scripts": "node --test tests/scripts/cleanup-external-state.spec.mjs",
    "test:harness": "playwright test --config tests/visual/playwright.config.ts tests/visual/screenshot-comparator.spec.ts tests/visual/calibrate-thresholds.spec.ts",
    "smoke:gate4": "playwright test --config tests/visual/gate-4-smoke.config.ts",
    "test:integration": "playwright test --config tests/integration/playwright.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:browser": "playwright test --config tests/e2e/playwright.config.ts tests/e2e/browser-headless.slow.spec.ts --timeout=120000",
    "test:e2e:browser:embedded": "playwright test --config tests/e2e/playwright.config.ts tests/e2e/browser-embedded.slow.spec.ts --timeout=120000",
    "test:e2e:browser:all": "playwright test --config tests/e2e/playwright.config.ts tests/e2e/browser-headless.slow.spec.ts tests/e2e/browser-embedded.slow.spec.ts --timeout=120000",
    "test:launch": "node scripts/run-launch-test.mjs",
    "calibrate": "tsx tests/visual/calibrate-thresholds.ts",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:privacy": "eslint -c .eslintrc.privacy.js --no-config-lookup --max-warnings 0 src/core/ src/main/",
    "check:no-cloud": "node scripts/check-no-cloud-adapter.mjs",
    "check:no-telemetry": "node scripts/check-no-telemetry-endpoint.mjs",
    "check:i18n-parity": "node scripts/check-i18n-parity.mjs",
    "check:stylelint": "stylelint --config .stylelintrc.tokens.json \"src/presentation/**/*.css\"",
    "format": "prettier --write .",
    "madge:circular": "madge --circular src/",
    "licenses": "license-checker --production --failOn 'GPL'",
    "check:license": "license-checker --production --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;CC0-1.0;Unlicense;0BSD;BlueOak-1.0.0\" --excludePackages \"argparse@2.0.1;flatbuffers@1.12.0;sherpa-ui-client@0.0.0\"",
    "rebuild": "cd node_modules/better-sqlite3 && npx prebuild-install --runtime electron --target 41.3.0 --arch x64",
    "rebuild:dev": "npm rebuild better-sqlite3",
    "typecheck": "tsc --noEmit",
    "dist:dry": "electron-builder --config electron-builder.yml --dir --publish never",
    "predist:win": "npm run rebuild",
    "dist:win": "npm run build && npm run build:main && electron-builder --win --publish never",
    "postdist:win": "npm run rebuild:dev",
    "predist:mac": "npm run rebuild",
    "dist:mac": "npm run build && npm run build:main && electron-builder --mac --publish never",
    "postdist:mac": "npm run rebuild:dev",
    "predist:lin": "npm run rebuild",
    "dist:lin": "npm run build && npm run build:main && electron-builder --linux --publish never",
    "postdist:lin": "npm run rebuild:dev"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-sql": "^6.10.0",
    "@huggingface/transformers": "^3.5.0",
    "better-sqlite3": "^12.9.0",
    "electron-updater": "^6.8.3",
    "node-pty": "^1.1.0",
    "papaparse": "^5.5.3",
    "playwright-core": "^1.60.0",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/rebuild": "^4.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/papaparse": "^5.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@uiw/react-codemirror": "^4.25.9",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ansi-regex": "^6.2.2",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.33.3",
    "cytoscape-fcose": "^2.2.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "gray-matter": "^4.0.3",
    "i18next": "^26.0.8",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.1.1",
    "license-checker": "^25.0.1",
    "lucide-react": "^1.14.0",
    "madge": "^8.0.0",
    "png-to-ico": "^3.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-arborist": "^3.5.0",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.34.5",
    "ssim.js": "^3.5.0",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vectra": "^0.14.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "zustand": "^5.0.12"
  },
  "license-checker": {
    "production": true,
    "failOn": "GPL"
  }
}
